{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Hotel offer aggregation service orchestrating two suppliers with Temporal and filtering offers in Redis",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:worker": "node --env-file-if-exists=.env dist/temporal/worker.js",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/temporal/worker.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/common": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.26.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.6",
    "@types/supertest": "^6.0.2",
    "ioredis-mock": "^8.9.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
