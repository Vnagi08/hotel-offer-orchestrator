              "",
              "pm.test('an unhealthy or disabled dependency carries an explanation', function () {",
              "    Object.keys(body.checks).forEach(function (name) {",
              "        if (body.checks[name].status !== 'healthy') {",
              "            pm.expect(body.checks[name].detail).to.be.a('string').that.is.not.empty;",
