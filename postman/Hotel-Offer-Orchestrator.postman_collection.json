    {
      "name": "Supplier outage scenarios (run with suppliers disabled)",
      "description": "These requests only pass while the corresponding supplier is switched off. Restart the API (and worker) with the environment variable set, then run this folder:\n\n```bash\n# partial results: Supplier A down\nSUPPLIER_A_ENABLED=false docker compose up -d --force-recreate api worker\n\n# total outage: both down\nSUPPLIER_A_ENABLED=false SUPPLIER_B_ENABLED=false docker compose up -d --force-recreate api worker\n```\n\nRequest 13 expects only Supplier A to be down. Request 14 expects both to be down. Each one skips its assertions when the stack is not in the matching state, so the folder never fails for the wrong reason.",
      "item": [
        {
          "name": "13. Partial results while Supplier A is down",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "With SUPPLIER_A_ENABLED=false the workflow retries Supplier A, gives up, and returns Supplier B-only results."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Record which suppliers are actually down so the tests below know what to assert.",
                  "pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/health', function (err, res) {",
                  "    if (err) { return; }",
                  "    const checks = res.json().checks;",
                  "    pm.collectionVariables.set('supplierAUp', String(checks.supplierA.status === 'healthy'));",
                  "    pm.collectionVariables.set('supplierBUp', String(checks.supplierB.status === 'healthy'));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const aUp = pm.collectionVariables.get('supplierAUp') === 'true';",
                  "const bUp = pm.collectionVariables.get('supplierBUp') === 'true';",
                  "",
                  "if (aUp || !bUp) {",
                  "    pm.test.skip('needs exactly Supplier A disabled - restart with SUPPLIER_A_ENABLED=false');",
                  "} else {",
                  "    pm.test('responds with HTTP 200 despite the outage', function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "",
                  "    const hotels = pm.response.json();",
                  "",
                  "    pm.test('returns partial results built only from Supplier B', function () {",
                  "        pm.expect(hotels).to.be.an('array').that.is.not.empty;",
                  "        hotels.forEach(function (hotel) {",
                  "            pm.expect(hotel.supplier).to.eql('Supplier B');",
                  "        });",
                  "    });",
                  "",
                  "    pm.test('falls back to Supplier B pricing for hotels Supplier A normally wins', function () {",
                  "        const radison = hotels.find(function (hotel) { return hotel.name.toLowerCase() === 'radison'; });",
                  "        pm.expect(radison.price).to.eql(6200);",
                  "        pm.expect(radison.commissionPct).to.eql(18);",
                  "    });",
                  "",
                  "    pm.test('Supplier A-only hotels disappear from the result', function () {",
                  "        const names = hotels.map(function (hotel) { return hotel.name; });",
                  "        pm.expect(names).to.not.include('Taj Palace');",
                  "        pm.expect(names).to.not.include('The Imperial');",
                  "    });",
                  "",
                  "    pm.test('results are still deduplicated and price ascending', function () {",
                  "        const names = hotels.map(function (hotel) { return hotel.name.toLowerCase(); });",
                  "        pm.expect(new Set(names).size).to.eql(names.length);",
                  "        for (let i = 1; i < hotels.length; i++) {",
                  "            pm.expect(hotels[i].price).to.be.at.least(hotels[i - 1].price);",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "14. Total outage: both suppliers down",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            },
            "description": "With both suppliers disabled the workflow fails with ApplicationFailure type BothSuppliersFailed, which maps to HTTP 502."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/health', function (err, res) {",
                  "    if (err) { return; }",
                  "    const checks = res.json().checks;",
                  "    pm.collectionVariables.set('supplierAUp', String(checks.supplierA.status === 'healthy'));",
                  "    pm.collectionVariables.set('supplierBUp', String(checks.supplierB.status === 'healthy'));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const aUp = pm.collectionVariables.get('supplierAUp') === 'true';",
                  "const bUp = pm.collectionVariables.get('supplierBUp') === 'true';",
                  "",
                  "if (aUp || bUp) {",
                  "    pm.test.skip('needs both suppliers disabled - restart with SUPPLIER_A_ENABLED=false SUPPLIER_B_ENABLED=false');",
                  "} else {",
                  "    pm.test('responds with HTTP 502', function () {",
                  "        pm.response.to.have.status(502);",
                  "    });",
                  "",
                  "    pm.test('reports SUPPLIERS_UNAVAILABLE in the standard envelope', function () {",
                  "        const body = pm.response.json();",
                  "        pm.expect(body.error.code).to.eql('SUPPLIERS_UNAVAILABLE');",
                  "        pm.expect(body.error.message).to.be.a('string').that.is.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "12. Supplier mock endpoint, unsupported city",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/supplierA/hotels?city=paris",
          "host": ["{{baseUrl}}"],
          "path": ["supplierA", "hotels"],
          "query": [{ "key": "city", "value": "paris" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds with 200 (enabled) or 503 (simulated outage)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test('an unsupported city yields an empty catalogue', function () {",
              "        pm.expect(pm.response.json()).to.eql([]);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
