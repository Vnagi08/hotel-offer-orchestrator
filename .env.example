# ---- API ----
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ---- Redis ----
# Inside Docker Compose this is redis://redis:6379
REDIS_URL=redis://localhost:6379
# TTL applied to each city's Redis snapshot (sorted set + hash), in seconds
HOTELS_TTL_SECONDS=300

# ---- Temporal ----
# Inside Docker Compose this is temporal:7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers-task-queue
# How long the API waits for a workflow to finish, in milliseconds
WORKFLOW_EXECUTION_TIMEOUT_MS=30000

# ---- Mock suppliers ----
# Base URLs the Temporal activities use to reach the supplier HTTP endpoints.
# Inside Docker Compose both are http://api:3000
SUPPLIER_A_BASE_URL=http://localhost:3000
SUPPLIER_B_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=3000

# Outage simulation: set to false to make that supplier's endpoint return HTTP 503
SUPPLIER_A_ENABLED=true
SUPPLIER_B_ENABLED=true
